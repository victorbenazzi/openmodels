---
import { getUseCaseRecommendations, modelFamilies, type ModelFamily } from '../data/models';
import FamilyLogo from './FamilyLogo.astro';

const recommendations = getUseCaseRecommendations();
const familyById = Object.fromEntries(modelFamilies.map(f => [f.id, f])) as Record<string, ModelFamily>;

const benchLabels: Record<string, string> = {
  aaii: 'AA',
  gpqa: 'GPQA',
  sweBench: 'SWE-bench',
  aime: 'AIME',
  mmluPro: 'MMLU-Pro',
  liveCodeBench: 'LiveCodeBench',
  mmmu: 'MMMU',
};

const useCaseOrder = [
  'coding', 'reasoning', 'math', 'agentic', 'longContext', 'selfHosting', 'multilingual', 'overall',
] as const;

const useCaseLabels: Record<string, string> = {
  coding: 'Best for Coding',
  reasoning: 'Best for Reasoning',
  math: 'Best for Math',
  agentic: 'Best for Agentic/Tool Use',
  longContext: 'Best for Long Context',
  selfHosting: 'Best for Self-Hosting',
  multilingual: 'Best for Multilingual',
  overall: 'Best Overall (Open Weight)',
};
---

<section id="use-cases" class="w-full flex justify-center items-center py-16 sm:py-20">
  <div class="w-full max-w-[1216px] px-6">
    <header class="mb-12 text-center">
      <h2 class="section-header">Best Model by Use Case</h2>
      <p class="mt-3 section-subheader max-w-2xl mx-auto">Recommendations based on the latest benchmarks, focused on open-weight models.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {useCaseOrder.map(key => {
        const rec = recommendations[key];
        const family = familyById[rec.familyId];
        const brand = family?.brandColor || '#0a0a0a';
        const benchmarkScores = rec.model.benchmarks;

        return (
          <article class="card card-hover group relative overflow-hidden p-5 flex flex-col animate-slide-up" style={`--brand: ${brand};`}>
            <span
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-0.5 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style={`background: linear-gradient(90deg, transparent, ${brand}, transparent);`}
            ></span>

            <div class="flex items-center gap-3 mb-4">
              <div class="relative shrink-0">
                <span aria-hidden="true" class="absolute -inset-1 rounded-xl opacity-25 blur-md" style={`background: ${brand};`}></span>
                {family && <FamilyLogo family={family} size={44} class="relative shadow-sm" />}
              </div>
              <div class="min-w-0">
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-50 leading-tight">{useCaseLabels[key]}</h3>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 truncate">{rec.model.name}</p>
              </div>
            </div>

            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4 flex-1">{rec.reason}</p>

            <div class="mb-4">
              <span class="text-[10px] font-medium uppercase tracking-[0.15em] text-neutral-400 dark:text-neutral-500">Benchmarks</span>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {Object.entries(benchmarkScores).map(([k, v]) => v !== undefined && (
                  <span class="badge badge-gray text-[10px] font-mono">
                    {benchLabels[k] || k} {v}
                  </span>
                ))}
              </div>
            </div>

            <div class="flex items-center gap-2 pt-4 border-t border-neutral-200 dark:border-neutral-800">
              <a href={family?.chatInterface} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs group/btn flex-1 justify-center py-1.5">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Chat
              </a>
              <a href={family?.huggingFace} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs justify-center px-3 py-1.5" title="Hugging Face" aria-label="Hugging Face">
                🤗
              </a>
              <a href={family?.github} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs justify-center px-3 py-1.5" title="GitHub" aria-label="GitHub">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.7c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/>
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
