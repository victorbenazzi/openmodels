---
import { Image } from 'astro:assets';
---

<div class="w-full flex-col items-center justify-center flex py-16 sm:py-24">
  <header class="flex flex-col w-full max-w-[1216px] min-h-[320px] h-fit items-start justify-center px-6 text-center">
    <div class="w-full flex flex-col items-center gap-6">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-[120%] text-neutral-950 dark:text-neutral-50 animate-fade-in">
        OpenModels
      </h1>
      <p class="hero-description text-base sm:text-lg text-neutral-500 dark:text-neutral-400 leading-[150%] max-w-2xl animate-slide-up">
        Catálogo dos principais modelos de IA chineses open source — benchmarks, links oficiais e pontos fortes em um só lugar.
      </p>
      <p class="hero-description text-base sm:text-lg text-neutral-500 dark:text-neutral-400 leading-[150%] max-w-2xl animate-slide-up" style="animation-delay: 100ms;">
        Chinese open-source AI models catalog — benchmarks, official links &amp; strengths in one place.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-4 animate-slide-up" style="animation-delay: 200ms;">
        <a href="#models" class="btn-primary group">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M18 15l-6-6-6 6"/>
          </svg>
          <span>Explorar Modelos</span>
        </a>
        <a href="https://github.com/victorbenazzi/openmodels" target="_blank" rel="noopener noreferrer" class="link-external group">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          <span>Código Fonte</span>
        </a>
      </div>
      <div class="flex items-center gap-4 text-xs text-neutral-400 dark:text-neutral-500 animate-fade-in" style="animation-delay: 300ms;">
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 bg-green-500 rounded-full"></span>
          Atualizado: Junho 2026
        </span>
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
          8 Labs Principais
        </span>
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
          25+ Modelos
        </span>
      </div>
    </div>
  </header>
</div>