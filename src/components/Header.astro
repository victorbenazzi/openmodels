---
import LanguageToggle from './LanguageToggle.tsx';
import ThemeToggle from './ThemeToggle.tsx';
---

<header class="flex justify-center items-center w-full h-14 border-b border-neutral-200 dark:border-neutral-800 sticky top-0 z-50 bg-white/80 dark:bg-neutral-950/80 backdrop-blur-sm">
  <div class="flex items-center justify-between w-full max-w-[1216px] px-6">
    <a href="/" class="flex items-center gap-2 text-sm font-semibold text-neutral-950 dark:text-neutral-50 hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors" aria-label="OpenModels Home">
      <svg width="20" height="20" viewBox="0 0 32 32" fill="none" class="text-neutral-900 dark:text-neutral-50">
        <rect width="32" height="32" rx="6" fill="currentColor"/>
        <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="16" fill="white">OM</text>
      </svg>
      <span class="hidden sm:block">OpenModels</span>
    </a>
    
    <nav class="flex items-center gap-6" aria-label="Main navigation">
      <a href="#models" class="link-external">Modelos</a>
      <a href="#benchmarks" class="link-external">Benchmarks</a>
      <a href="#use-cases" class="link-external">Casos de Uso</a>
      <div class="flex items-center gap-2">
        <LanguageToggle id="lang-toggle" />
        <ThemeToggle id="theme-toggle" />
      </div>
    </nav>
  </div>
</header>