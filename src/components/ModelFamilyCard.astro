---
import { modelFamilies, type ModelFamily, getModelTypeLabel, getModelTypeBadgeClass } from '../data/models';
import type { Locale } from '../scripts/i18n';

interface Props {
  family: ModelFamily;
  locale: Locale;
}

const { family, locale } = Astro.props;
const t = (key: string) => {
  const translations: Record<string, Record<Locale, string>> = {
    officialWebsite: { pt: 'Site Oficial', en: 'Official Website' },
    chatInterface: { pt: 'Chat', en: 'Chat' },
    huggingFace: { pt: 'Hugging Face', en: 'Hugging Face' },
    githubRepo: { pt: 'GitHub', en: 'GitHub' },
    flagshipModel: { pt: 'Modelo Principal', en: 'Flagship Model' },
    contextWindow: { pt: 'Janela de Contexto', en: 'Context Window' },
    license: { pt: 'Licença', en: 'License' },
    openWeight: { pt: 'Pesos Abertos', en: 'Open Weight' },
    closedWeight: { pt: 'Pesos Fechados', en: 'Closed Weight' },
    viewDetails: { pt: 'Ver detalhes', en: 'View details' },
    hideDetails: { pt: 'Ocultar', en: 'Hide' },
    strengthsTitle: { pt: 'Pontos Fortes', en: 'Strengths' },
    updated: { pt: 'Atualizado', en: 'Updated' },
  };
  return translations[key]?.[locale] || key;
};

const flagship = family.models.reduce((prev, curr) => 
  (curr.benchmarks.benchlm || 0) > (prev.benchmarks.benchlm || 0) ? curr : prev
);
---

<article id={family.id} class="card card-hover overflow-hidden animate-slide-up">
  <button 
    class="expand-trigger" 
    aria-expanded="false" 
    aria-controls={`${family.id}-details`}
    data-expanded="false"
  >
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-lg flex items-center justify-center text-white" style="background: var(--brand-color, #0a0a0a);" aria-hidden="true">
        <img src={`/logos/${family.id}.svg`} alt="" width="24" height="24" class="invert" />
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-50 truncate">{family.name}</h3>
          <span class="tag">{family.creator}</span>
        </div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 truncate mt-1">{family.description[locale]}</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class={`model-type-badge ${getModelTypeBadgeClass(flagship.type)}`}>
          {getModelTypeLabel(flagship.type, locale)}
        </span>
        {flagship.benchmarks.benchlm && (
          <span class="badge badge-blue font-mono">
            BenchLM: {flagship.benchmarks.benchlm}
          </span>
        )}
        <span class={`badge ${flagship.isOpenWeight ? 'badge-green' : 'badge-gray'}`}>
          {flagship.isOpenWeight ? t('openWeight') : t('closedWeight')}
        </span>
      </div>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-400 dark:text-neutral-500 transition-transform duration-200 expand-icon" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </div>
  </button>

  <div id={`${family.id}-details`} class="expand-content max-h-0 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50">
    <div class="p-4 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href={family.website} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center group">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <path d="M15 3h6v6"/>
            <path d="M10 14L21 3"/>
          </svg>
          <span>{t('officialWebsite')}</span>
        </a>
        <a href={family.chatInterface} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center group">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span>{t('chatInterface')}</span>
        </a>
        <a href={family.huggingFace} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center group">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M17 18a5 5 0 0 0-10 0"/>
            <path d="M12 2a10 10 0 0 0 0 20"/>
            <path d="M7 8a3 3 0 0 1 6 0"/>
          </svg>
          <span>{t('huggingFace')}</span>
        </a>
        <a href={family.github} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center group">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          <span>{t('githubRepo')}</span>
        </a>
      </div>

      <div class="divider" />

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        <div>
          <span class="text-neutral-400 dark:text-neutral-500 block mb-1">{t('flagshipModel')}</span>
          <span class="font-medium text-neutral-900 dark:text-neutral-50">{flagship.name}</span>
        </div>
        <div>
          <span class="text-neutral-400 dark:text-neutral-500 block mb-1">{t('contextWindow')}</span>
          <span class="font-medium text-neutral-900 dark:text-neutral-50">{flagship.contextWindow}</span>
        </div>
        <div>
          <span class="text-neutral-400 dark:text-neutral-500 block mb-1">{t('license')}</span>
          <span class="font-medium text-neutral-900 dark:text-neutral-50">{flagship.license}</span>
        </div>
      </div>

      <div class="divider" />

      <div>
        <h4 class="text-xs font-medium uppercase tracking-[0.15em] text-neutral-950 dark:text-neutral-50 mb-3">{t('strengthsTitle')}</h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {family.strengths.map(strength => {
            const strengthLabels: Record<string, Record<Locale, string>> = {
              coding: { pt: 'Coding', en: 'Coding' },
              reasoning: { pt: 'Reasoning', en: 'Reasoning' },
              math: { pt: 'Matemática', en: 'Math' },
              agentic: { pt: 'Agentes/Tool Use', en: 'Agentic/Tool Use' },
              longContext: { pt: 'Contexto Longo', en: 'Long Context' },
              multilingual: { pt: 'Multilíngue', en: 'Multilingual' },
              multimodal: { pt: 'Multimodal', en: 'Multimodal' },
              speed: { pt: 'Velocidade', en: 'Speed' },
              selfHosting: { pt: 'Self-Hosting', en: 'Self-Hosting' },
            };
            const label = strengthLabels[strength.category]?.[locale] || strength.category;
            const width = Math.round((strength.score / 10) * 100);
            return (
              <div class="flex flex-col gap-1">
                <div class="flex justify-between text-[11px]">
                  <span class="text-neutral-500 dark:text-neutral-400">{label}</span>
                  <span class="font-mono font-medium text-neutral-900 dark:text-neutral-50">{strength.score}/10</span>
                </div>
                <div class="strength-bar">
                  <div class="strength-fill bg-neutral-900 dark:bg-neutral-50" style={{ width: '0%' }} data-width={width} />
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="pt-2 text-xs text-neutral-400 dark:text-neutral-500">
        {t('updated')}: {family.updatedAt}
      </div>
    </div>
  </div>
</article>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('[data-expanded]');
    
    cards.forEach(card => {
      const trigger = card.querySelector('button');
      const content = card.querySelector('[id$="-details"]');
      const icon = card.querySelector('.expand-icon');
      
      if (!trigger || !content) return;
      
      trigger.addEventListener('click', () => {
        const isExpanded = card.getAttribute('data-expanded') === 'true';
        const newState = !isExpanded;
        
        card.setAttribute('data-expanded', String(newState));
        trigger.setAttribute('aria-expanded', String(newState));
        
        if (newState) {
          content.style.maxHeight = content.scrollHeight + 'px';
          if (icon) icon.style.transform = 'rotate(180deg)';
          
          // Animate strength bars
          const fills = content.querySelectorAll('[data-width]');
          fills.forEach(fill => {
            const width = fill.getAttribute('data-width');
            if (width) {
              setTimeout(() => {
                (fill as HTMLElement).style.width = width + '%';
              }, 100);
            }
          });
        } else {
          content.style.maxHeight = '0px';
          if (icon) icon.style.transform = 'rotate(0deg)';
          
          // Reset strength bars
          const fills = content.querySelectorAll('[data-width]');
          fills.forEach(fill => {
            (fill as HTMLElement).style.width = '0%';
          });
        }
      });
    });
  });
</script>

<style>
  .expand-content {
    transition: max-height 0.3s ease-out, opacity 0.2s ease-out;
    opacity: 1;
  }
  
  .expand-content[style*="max-height: 0px"] {
    opacity: 0;
  }
  
  .expand-icon {
    transition: transform 0.2s ease-out;
  }
  
  .strength-fill {
    transition: width 0.5s ease-out;
  }
</style>