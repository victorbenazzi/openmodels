---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ModelFamilyCard from '../components/ModelFamilyCard.astro';
import BenchmarkTable from '../components/BenchmarkTable.tsx';
import UseCaseGuide from '../components/UseCaseGuide.astro';
import Footer from '../components/Footer.astro';
import { modelFamilies, getModelCount, regionOrder, regionLabels, getFamiliesByRegion } from '../data/models';

const labsCount = modelFamilies.length;
const modelsCount = getModelCount();
---

<Layout title="OpenModels: Open-Weight AI Models Catalog" description="Compare benchmarks, access official interfaces, and discover the right open-weight AI model for your use case. Open models from China, the US, Europe and beyond.">
  <Header />
  <main class="flex-1">
    <Hero />

    <section id="models" class="w-full flex justify-center items-center py-16 sm:py-20">
      <div class="w-full max-w-[1216px] px-6">
        <header class="mb-12">
          <h2 class="section-header">Labs &amp; Families</h2>
          <p class="mt-3 section-subheader max-w-2xl">
            {`${labsCount} labs and ${modelsCount} open-weight models, organized by region. Click a card to see details, links and the full family.`}
          </p>
        </header>

        {regionOrder.map(region => {
          const families = getFamiliesByRegion(region);
          if (families.length === 0) return null;
          return (
            <div class="mb-12 last:mb-0">
              <div class="flex items-baseline gap-3 mb-5">
                <h3 class="text-sm font-semibold uppercase tracking-[0.15em] text-neutral-900 dark:text-neutral-100">{regionLabels[region]}</h3>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 tabular-nums">{families.length}</span>
                <span class="flex-1 h-px bg-neutral-200 dark:bg-neutral-800"></span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                {families.map(family => (
                  <ModelFamilyCard family={family} />
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section id="benchmarks" class="w-full flex justify-center items-center py-16 sm:py-20 bg-neutral-50/50 dark:bg-neutral-900/40 border-y border-neutral-200 dark:border-neutral-800">
      <div class="w-full max-w-[1216px] px-6">
        <header class="mb-8">
          <h2 class="section-header">Benchmark Comparison</h2>
          <p class="mt-3 section-subheader max-w-2xl">
            Filter by region, type or openness and sort by the headers. Click any row to open the model's details. Higher values = better. AA Index is the Artificial Analysis composite (a different scale from the other columns, which are percentages).
          </p>
        </header>
        <BenchmarkTable client:load />
      </div>
    </section>

    <UseCaseGuide />

    <Footer />
  </main>
</Layout>
