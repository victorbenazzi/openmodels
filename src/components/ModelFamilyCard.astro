---
import { type ModelFamily, getModelTypeLabel, getModelTypeBadgeClass, getScoreClass, getOpennessLabel, getOpennessBadgeClass, isOpenWeight } from '../data/models';
import FamilyLogo from './FamilyLogo.astro';

interface Props {
  family: ModelFamily;
}

const { family } = Astro.props;
const modalId = `${family.id}-modal`;

// Flagship: the first open-weight model (data is authored flagship-first),
// falling back to the first model if every entry is closed.
const flagship = family.models.find(m => isOpenWeight(m.openness)) ?? family.models[0];

const strengthLabels: Record<string, string> = {
  coding: 'Coding',
  reasoning: 'Reasoning',
  math: 'Math',
  agentic: 'Agentic/Tool Use',
  'long-context': 'Long Context',
  multilingual: 'Multilingual',
  multimodal: 'Multimodal',
  speed: 'Speed',
  'self-hosting': 'Self-Hosting',
};
---

<article
  id={family.id}
  class="card card-hover group relative overflow-hidden animate-slide-up scroll-mt-20"
  style={`--brand: ${family.brandColor};`}
>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-0.5 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style={`background: linear-gradient(90deg, transparent, ${family.brandColor}, transparent);`}
  ></span>
  <button
    type="button"
    class="modal-trigger w-full text-left p-5 cursor-pointer"
    data-modal-open={modalId}
    aria-haspopup="dialog"
  >
    <div class="flex items-start gap-4">
      <div class="relative shrink-0">
        <span
          aria-hidden="true"
          class="absolute -inset-1 rounded-xl opacity-25 blur-md transition-opacity duration-300 group-hover:opacity-40"
          style={`background: ${family.brandColor};`}
        ></span>
        <FamilyLogo family={family} size={48} class="relative shadow-sm" />
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-50 leading-tight truncate">{family.name}</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 truncate">
              <span aria-hidden="true">{family.country}</span> {family.creator}
            </p>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5 text-neutral-400 dark:text-neutral-500 transition-colors group-hover:text-neutral-700 dark:group-hover:text-neutral-200" aria-hidden="true">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
          </svg>
        </div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mt-2 line-clamp-2">{family.description}</p>
        <div class="flex items-center gap-1.5 flex-wrap mt-3">
          <span class={`model-type-badge ${getModelTypeBadgeClass(flagship.type)}`}>
            {getModelTypeLabel(flagship.type)}
          </span>
          {flagship.benchmarks.aaii !== undefined && (
            <span class="badge badge-blue font-mono">
              AA {flagship.benchmarks.aaii}
            </span>
          )}
          <span class={`badge ${getOpennessBadgeClass(flagship.openness)}`}>
            {getOpennessLabel(flagship.openness)}
          </span>
        </div>
      </div>
    </div>
  </button>
</article>

<dialog
  id={modalId}
  class="model-modal m-auto w-[min(94vw,46rem)] max-h-[88vh] rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 p-0 shadow-2xl backdrop:bg-neutral-950/50 backdrop:backdrop-blur-sm"
  aria-labelledby={`${modalId}-title`}
  style={`--brand: ${family.brandColor};`}
>
  <div class="flex flex-col max-h-[88vh]">
    <!-- Header -->
    <header class="flex items-start gap-4 p-6 border-b border-neutral-200 dark:border-neutral-800">
      <FamilyLogo family={family} size={48} class="shrink-0 shadow-sm" />
      <div class="flex-1 min-w-0">
        <h2 id={`${modalId}-title`} class="text-lg font-semibold text-neutral-900 dark:text-neutral-50 leading-tight">{family.name}</h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-0.5">
          <span aria-hidden="true">{family.country}</span> {family.creator}
        </p>
      </div>
      <button
        type="button"
        class="modal-close shrink-0 -mt-1 -mr-1 flex h-8 w-8 items-center justify-center rounded-lg text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-50 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        aria-label="Close"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <!-- Scrollable body -->
    <div class="overflow-y-auto p-6 space-y-6">
      <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">{family.description}</p>

      <!-- Links -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <a href={family.website} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center group/btn py-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/></svg>
          <span>Website</span>
        </a>
        <a href={family.chatInterface} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center py-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Chat</span>
        </a>
        <a href={family.huggingFace} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center py-2">
          <span aria-hidden="true">🤗</span>
          <span>Hugging Face</span>
        </a>
        <a href={family.github} target="_blank" rel="noopener noreferrer" class="btn-primary justify-center py-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.7c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
          <span>GitHub</span>
        </a>
      </div>

      <!-- Flagship -->
      <div class="grid grid-cols-3 gap-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 p-4 text-sm">
        <div>
          <span class="text-neutral-400 dark:text-neutral-500 block mb-1 text-xs">Flagship Model</span>
          <span class="font-medium text-neutral-900 dark:text-neutral-50">{flagship.name}</span>
        </div>
        <div>
          <span class="text-neutral-400 dark:text-neutral-500 block mb-1 text-xs">Context Window</span>
          <span class="font-medium text-neutral-900 dark:text-neutral-50 font-mono">{flagship.contextWindow}</span>
        </div>
        <div>
          <span class="text-neutral-400 dark:text-neutral-500 block mb-1 text-xs">License</span>
          <span class="font-medium text-neutral-900 dark:text-neutral-50">{flagship.license}</span>
        </div>
      </div>

      <!-- Strengths -->
      <div>
        <h3 class="text-xs font-medium uppercase tracking-[0.15em] text-neutral-950 dark:text-neutral-50 mb-3">Strengths</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-3">
          {family.strengths.map(strength => {
            const label = strengthLabels[strength.category] || strength.category;
            const width = Math.round((strength.score / 10) * 100);
            return (
              <div class="flex flex-col gap-1.5">
                <div class="flex items-baseline justify-between gap-2 text-[11px]">
                  <span class="text-neutral-500 dark:text-neutral-400 truncate">{label}</span>
                  <span class="font-mono font-medium text-neutral-900 dark:text-neutral-50 shrink-0">{strength.score}</span>
                </div>
                <div class="strength-bar">
                  <div class="strength-fill" style={`width:0%; background:${family.brandColor};`} data-width={width} />
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- All models -->
      <div>
        <h3 class="text-xs font-medium uppercase tracking-[0.15em] text-neutral-950 dark:text-neutral-50 mb-3">Family models</h3>
        <div class="overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-800">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-neutral-50 dark:bg-neutral-900 text-[11px] uppercase tracking-[0.1em] text-neutral-500 dark:text-neutral-400">
                <th class="text-left font-medium px-3 py-2">Model</th>
                <th class="text-left font-medium px-3 py-2 hidden sm:table-cell">Type</th>
                <th class="text-right font-medium px-3 py-2">Params</th>
                <th class="text-right font-medium px-3 py-2 hidden sm:table-cell">Context</th>
                <th class="text-right font-medium px-3 py-2">AA</th>
              </tr>
            </thead>
            <tbody>
              {family.models.map(model => (
                <tr class="border-t border-neutral-100 dark:border-neutral-800/70" data-model-id={model.id}>
                  <td class="px-3 py-2">
                    <div class="flex items-center gap-2">
                      <span class={`h-1.5 w-1.5 rounded-full shrink-0 ${model.openness === 'closed' ? 'bg-neutral-400 dark:bg-neutral-600' : model.openness === 'restricted' ? 'bg-amber-500' : 'bg-green-500'}`} title={getOpennessLabel(model.openness)}></span>
                      <span class="font-medium text-neutral-800 dark:text-neutral-200">{model.name}</span>
                    </div>
                  </td>
                  <td class="px-3 py-2 hidden sm:table-cell">
                    <span class={`model-type-badge ${getModelTypeBadgeClass(model.type)}`}>{getModelTypeLabel(model.type)}</span>
                  </td>
                  <td class="px-3 py-2 text-right font-mono text-neutral-600 dark:text-neutral-400">{model.parameters}{model.activeParams ? `/${model.activeParams}` : ''}</td>
                  <td class="px-3 py-2 text-right font-mono text-neutral-600 dark:text-neutral-400 hidden sm:table-cell">{model.contextWindow}</td>
                  <td class={`px-3 py-2 text-right font-mono font-medium ${getScoreClass(model.benchmarks.aaii, 'aaii')}`}>{model.benchmarks.aaii ?? '-'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-xs text-neutral-400 dark:text-neutral-500">Updated: {family.updatedAt}</p>
    </div>
  </div>
</dialog>

<script>
  function animateBars(dialog: HTMLDialogElement) {
    const fills = dialog.querySelectorAll<HTMLElement>('[data-width]');
    fills.forEach(fill => {
      const w = fill.getAttribute('data-width');
      if (w) requestAnimationFrame(() => setTimeout(() => { fill.style.width = w + '%'; }, 80));
    });
  }

  function openModelModal(familyId: string, modelId?: string) {
    const dialog = document.getElementById(`${familyId}-modal`) as HTMLDialogElement | null;
    if (!dialog || typeof dialog.showModal !== 'function') return;
    dialog.showModal();
    animateBars(dialog);
    // Briefly highlight the requested model row inside the modal.
    if (modelId) {
      const row = dialog.querySelector<HTMLElement>(`[data-model-id="${modelId}"]`);
      if (row) {
        row.classList.add('model-row-flash');
        row.scrollIntoView({ block: 'nearest' });
        setTimeout(() => row.classList.remove('model-row-flash'), 1600);
      }
    }
  }
  // Expose for other islands (e.g. the benchmark table and the site search).
  (window as any).openModelModal = openModelModal;

  function initModelModals() {
    document.querySelectorAll<HTMLButtonElement>('[data-modal-open]').forEach(trigger => {
      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';
      const id = trigger.getAttribute('data-modal-open');
      const dialog = id ? document.getElementById(id) as HTMLDialogElement | null : null;
      if (!dialog) return;

      trigger.addEventListener('click', () => { dialog.showModal(); animateBars(dialog); });
      dialog.querySelector('.modal-close')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => {
        dialog.querySelectorAll<HTMLElement>('[data-width]').forEach(fill => { fill.style.width = '0%'; });
      });
    });
  }

  initModelModals();
  document.addEventListener('astro:page-load', initModelModals);
</script>

<style>
  .strength-fill {
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .model-row-flash {
    animation: model-row-flash 1.6s ease-out;
  }
  @keyframes model-row-flash {
    0%, 30% { background: color-mix(in srgb, var(--brand) 22%, transparent); }
    100% { background: transparent; }
  }

  /* Modal enter animation */
  dialog.model-modal[open] {
    animation: modal-in 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }
  dialog.model-modal[open]::backdrop {
    animation: backdrop-in 0.22s ease-out;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strength-fill { transition: none; }
    .model-row-flash { animation: none; }
    dialog.model-modal[open],
    dialog.model-modal[open]::backdrop { animation: none; }
  }
</style>
